# ─── IA ─────────────────────────────────────────────────────────────────────
# Gemini API — transcripciones de video y embeddings semánticos
# Obtener en: aistudio.google.com → Get API key
GEMINI_API_KEY=

# Groq API — limpieza de transcripciones (LLaMA 3.1 8B) y AI Chat (LLaMA 3.3 70B)
# Obtener en: console.groq.com → API Keys → Create
GROQ_API_KEY=

# ─── INSTAGRAM GRAPH API ─────────────────────────────────────────────────────
# Long-lived access token — expira cada 60 días, renovar mensualmente
# Ver guía completa en: ../referencia/ig-api-guide.md
INSTAGRAM_ACCESS_TOKEN=

# ID numérico de tu cuenta de Instagram
# Obtener con: GET https://graph.facebook.com/v21.0/me?fields=id&access_token={TOKEN}
INSTAGRAM_USER_ID=

# ─── SUPABASE ────────────────────────────────────────────────────────────────
# Crear proyecto en: supabase.com → New Project
# Obtener en: Settings → API
# Schema SQL para ejecutar: supabase/schema.sql
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── LOGIN DEL EQUIPO (producción) ───────────────────────────────────────────
# Contraseña compartida para acceder al dashboard publicado.
# Si está vacía, el dashboard NO pide login (útil en desarrollo local).
# En Vercel: configurarla SIEMPRE para que solo el equipo entre.
DASHBOARD_PASSWORD=

# ─── OPCIONALES (de pago — mejoran calidad de análisis e ideas) ──────────────
# Claude Sonnet 4.6 — para ideas de contenido y análisis estratégico
# Obtener en: console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=

# GPT-4o — alternativa a Claude
# Obtener en: platform.openai.com → API keys
# OPENAI_API_KEY=

# ---- TikTok (Display API) ----
# Se sacan de https://developers.tiktok.com → tu app → Manage apps
# La app necesita los productos "Login Kit" y "Display API" APROBADOS.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Debe coincidir CARACTER POR CARACTER con la URL registrada en TikTok.
# En produccion: https://dermatinta-content-os.vercel.app/api/tiktok/callback
# En local:      http://localhost:3000/api/tiktok/callback
TIKTOK_REDIRECT_URI=

# Firma que TikTok pide para verificar la propiedad del dominio.
# Se pega tal cual la da TikTok en "Propiedades de URL". Con esto puesta,
# CUALQUIER /tiktok*.txt responde la firma: no hay que crear el archivo ni
# desplegar por cada intento de verificacion.
TIKTOK_VERIFICATION_SIGNATURE=
# Alternativa por meta tag, si TikTok ofrece ese metodo en vez del archivo.
TIKTOK_SITE_VERIFICATION=
