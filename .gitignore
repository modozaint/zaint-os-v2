# MODOZAINT V2 - gitignore

# Regenerables
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/
.vercel/

# Caches y temporales
.cache/
*.log
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
desktop.ini

# Secretos
.env
.env.*
*.pem
*.key
credentials.json
service-account*.json
VERCEL-VARIABLES.txt
*.env.respaldo
.env.local.respaldo

# Ejemplos sanitizados si se versionan
!.env.example
!.env.*.example
!*.env.example
_ARCHIVO/**/.env*.example

# Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Medios pesados
*.mp4
*.mov
*.avi
*.zip
*.psd
*.ai

# Python cache
__pycache__/
*.pyc
